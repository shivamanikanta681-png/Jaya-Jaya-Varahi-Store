# Jaya Jaya Varahi Shop - Environment Configuration
# ----------------------------------------------------
APP_ENV=development
PORT=8000
ALLOWED_ORIGIN=http://localhost:8000

# Supabase Credentials (Unified Source of Truth)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Owner & Admin Dashboard Credentials (Server Authorized)
ADMIN_PASSWORD=your_secure_admin_password

# AI Customer Support Assistant (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Free Gmail SMTP OTP System
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate an App Password (16 characters): https://myaccount.google.com/apppasswords
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_SENDER_NAME=Jaya Jaya Varahi Shop

# ────────────────────────────────────────────────────
# Real Mobile SMS OTP Provider Configuration
# ────────────────────────────────────────────────────
# Supported SMS_PROVIDER values:
#   - fast2sms  (Fast2SMS India Quick Transactional/OTP Route - Recommended for India)
#   - msg91     (MSG91 India DLT / Flow API)
#   - twilio    (Twilio Programmable SMS)
#   - console   (Local development & testing logger)
SMS_PROVIDER=console

# Fast2SMS (India) Configuration
# Sign up at https://www.fast2sms.com/ to get your API authorization key
SMS_API_KEY=your_fast2sms_or_sms_provider_api_key
SMS_SENDER_ID=JJVSHP
SMS_TEMPLATE_ID=your_dlt_or_provider_template_id

# Twilio Configuration (If SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+1234567890

