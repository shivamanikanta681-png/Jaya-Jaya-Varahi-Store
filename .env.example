# Jaya Jaya Varahi Shop - Environment Configuration
# ----------------------------------------------------
APP_ENV=development
PORT=8000
ALLOWED_ORIGIN=http://localhost:8000

# Supabase Credentials (Unified Source of Truth)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Owner & Admin Dashboard Credentials (Server Authorized)
ADMIN_PASSWORD=Varahi#12345

# AI Customer Support Assistant (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Free Gmail SMTP OTP System
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate an App Password (16 characters): https://myaccount.google.com/apppasswords
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_SENDER_NAME=Jaya Jaya Varahi Shop

# ────────────────────────────────────────────────────
# Firebase Admin SDK Configuration (Server-Side Only)
# Used exclusively to cryptographically verify Firebase ID tokens at /api/auth/firebase-phone
# NEVER put service account private keys in frontend code, git, or public files!
# ────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=jaya-jaya-varahi-shop
# Optional: Path to Firebase service account JSON file on your server / container
FIREBASE_SERVICE_ACCOUNT_PATH=
# Optional: Raw JSON string of service account for Vercel / serverless environment variables
FIREBASE_SERVICE_ACCOUNT_JSON=

# ────────────────────────────────────────────────────
# Note on Customer Mobile Authentication:
# Customer mobile login & registration uses Firebase Authentication Phone Sign-In
# (Free development & testing with pre-configured Firebase test phone numbers).
# The SMS_PROVIDER configuration below is NOT used for customer mobile authentication.
# ────────────────────────────────────────────────────
SMS_PROVIDER=console
SMS_API_KEY=your_optional_sms_api_key
SMS_SENDER_ID=JJVSHP
SMS_TEMPLATE_ID=your_optional_template_id

# Twilio Configuration (If SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+1234567890
